# D13: the build's package registry is the PLATFORM's, not the app's.
#
# This file is written into the build context AFTER the app's own tree, so an app
# that commits its own `.npmrc` has it overwritten rather than honoured. S1 lost a
# build to that ordering in the other direction: `.npmrc` copied after `npm install`
# meant the first build silently used the PUBLIC npm registry while appearing to
# succeed, and only inspecting the mirror's storage caught it.
registry=http://manifest-verdaccio:4873/

# D13 IS NOT COMPLETE WITHOUT THIS. `registry=` only decides where npm looks up a
# package; `npm ci` fetches each TARBALL from the `resolved` URL recorded in the
# lockfile, and npm's default `replace-registry-host=npmjs` rewrites that host only
# when it is literally registry.npmjs.org. So an app whose lockfile was generated
# against any other registry — a company proxy, a different mirror, or this
# platform's own published port — keeps that host and the build reaches for it
# directly, past the mirror. Offline that is a hard failure inside the builder; with
# the network up it is S1's silently-wrong build for a third time.
#
# `always` makes the platform's registry the source of every tarball regardless of
# what the app's lockfile says, which is what D13 actually claims.
replace-registry-host=always

# The mirror is plain HTTP on an internal network that has no route off itself, and
# the builder cannot reach a certificate authority to verify anything anyway.
strict-ssl=false

# Both need the network. Offline they are a slow failure, which is C1's whole point.
audit=false
fund=false
