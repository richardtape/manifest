{
  "openapi": "3.1.0",
  "info": {
    "title": "Manifest",
    "version": "0.1.0",
    "description": "Manifest's public API (§22). Generated from the control plane's route definitions; do not edit. Resource routes are under /v1 (D23.8); a breaking change is a new prefix beside it. Response objects may gain fields under /v1 — a client ignores fields it does not know. Every mutation carries an Idempotency-Key, and a session-bearing mutation carries Origin (§20)."
  },
  "servers": [
    {
      "url": "https://console.manifest.internal",
      "description": "The laptop platform (§21). The console and the API share this origin."
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "tags": [
    {
      "name": "identity"
    },
    {
      "name": "projects"
    }
  ],
  "paths": {
    "/v1/environments/{environmentId}": {
      "get": {
        "operationId": "getEnvironment",
        "tags": [
          "projects"
        ],
        "summary": "An environment, and what it serves",
        "description": "The environment and the instance its hostname reaches (§6 Route) — not the newest deploy, which may have failed.",
        "parameters": [
          {
            "name": "environmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The environment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Environment"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, NOT_FOUND, REQUEST_INVALID, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "NOT_FOUND",
          "REQUEST_INVALID",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "identity"
        ],
        "summary": "The signed-in person",
        "description": "Who this session belongs to, and the platform role it is authorized as. Every client calls it first.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The person.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, REQUEST_INVALID, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "REQUEST_INVALID",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "tags": [
          "projects"
        ],
        "summary": "The projects I am a member of",
        "description": "Every project the caller owns or collaborates on, newest first — for administrators too. The fleet is GET /v1/fleet.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The caller’s projects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, REQUEST_INVALID, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "REQUEST_INVALID",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/v1/projects/{projectId}": {
      "get": {
        "operationId": "getProject",
        "tags": [
          "projects"
        ],
        "summary": "A project",
        "description": "One project; `?expand=environments` includes its three environments, each with the instance it serves (D23.1).",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            }
          },
          {
            "name": "expand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "const": "environments"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, NOT_FOUND, REQUEST_INVALID, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "NOT_FOUND",
          "REQUEST_INVALID",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/v1/projects/{projectId}/environments": {
      "get": {
        "operationId": "listEnvironments",
        "tags": [
          "projects"
        ],
        "summary": "A project’s environments",
        "description": "Sandbox, staging and production — all three exist from the moment the project does (§23).",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The environments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentList"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, NOT_FOUND, REQUEST_INVALID, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "NOT_FOUND",
          "REQUEST_INVALID",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/v1/projects/{projectId}/members": {
      "get": {
        "operationId": "listMembers",
        "tags": [
          "projects"
        ],
        "summary": "Who is a member of a project",
        "description": "Owners and collaborators (§13). Reading is `project:read`; changing membership is `members:manage`.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The members.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberList"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, NOT_FOUND, REQUEST_INVALID, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "NOT_FOUND",
          "REQUEST_INVALID",
          "UNAUTHENTICATED"
        ]
      },
      "post": {
        "operationId": "addMember",
        "tags": [
          "projects"
        ],
        "summary": "Add or change a member",
        "description": "Grants a person who has signed in once a role on the project. One of D24’s privileged four: a delegated token will never hold it (P5b).",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "D23.6. One per user action, reused across retries of THAT action.",
            "schema": {
              "type": "string",
              "minLength": 8
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The member, as they now are.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: CSRF_ORIGIN_REFUSED, FORBIDDEN, IDEMPOTENCY_KEY_REQUIRED, IDEMPOTENCY_KEY_REUSED, INTERNAL, MEMBER_USER_NOT_FOUND, NOT_FOUND, REQUEST_BODY_TOO_LARGE, REQUEST_INVALID, REQUEST_MEDIA_TYPE_UNSUPPORTED, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "CSRF_ORIGIN_REFUSED",
          "FORBIDDEN",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_REUSED",
          "INTERNAL",
          "MEMBER_USER_NOT_FOUND",
          "NOT_FOUND",
          "REQUEST_BODY_TOO_LARGE",
          "REQUEST_INVALID",
          "REQUEST_MEDIA_TYPE_UNSUPPORTED",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/v1/projects/{projectId}/spec": {
      "get": {
        "operationId": "getSpec",
        "tags": [
          "projects"
        ],
        "summary": "The project’s newest valid manifest",
        "description": "manifest.yaml as last validated (§7). An invalid newest manifest answers SPEC_INVALID with its errors.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The spec.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Spec"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, NOT_FOUND, REQUEST_INVALID, SPEC_INVALID, SPEC_NOT_FOUND, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "NOT_FOUND",
          "REQUEST_INVALID",
          "SPEC_INVALID",
          "SPEC_NOT_FOUND",
          "UNAUTHENTICATED"
        ]
      },
      "post": {
        "operationId": "validateSpec",
        "tags": [
          "projects"
        ],
        "summary": "Validate manifest.yaml at a commit",
        "description": "§22 step 3: reads manifest.yaml at the commit (HEAD by default), validates it (§7) and records the result. A sensitive diff (D9) is reported, not yet enforced.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "D23.6. One per user action, reused across retries of THAT action.",
            "schema": {
              "type": "string",
              "minLength": 8
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateSpecRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The validation, valid or not — an invalid manifest is a recorded answer, not a refusal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpecValidation"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: AI_BACKEND_UNAVAILABLE, AI_CATALOGUE_EMPTY, CSRF_ORIGIN_REFUSED, FORBIDDEN, IDEMPOTENCY_KEY_REQUIRED, IDEMPOTENCY_KEY_REUSED, INTERNAL, NOT_FOUND, REQUEST_BODY_TOO_LARGE, REQUEST_INVALID, REQUEST_MEDIA_TYPE_UNSUPPORTED, SOURCE_GIT_FAILED, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "AI_BACKEND_UNAVAILABLE",
          "AI_CATALOGUE_EMPTY",
          "CSRF_ORIGIN_REFUSED",
          "FORBIDDEN",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_REUSED",
          "INTERNAL",
          "NOT_FOUND",
          "REQUEST_BODY_TOO_LARGE",
          "REQUEST_INVALID",
          "REQUEST_MEDIA_TYPE_UNSUPPORTED",
          "SOURCE_GIT_FAILED",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/v1/slugs/{slug}": {
      "get": {
        "operationId": "checkSlug",
        "tags": [
          "projects"
        ],
        "summary": "Would this project name work?",
        "description": "§23: answers exactly what project creation will, so a client can tell a person while they type. Always 200 — the answer is about the name, and a 4xx would make \"taken\" indistinguishable from \"not allowed to ask\". Says nothing about a holder. 60 a minute per person.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The verdict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlugCheck"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the D23.7 envelope. This operation can answer: INTERNAL, RATE_LIMITED, REQUEST_INVALID, UNAUTHENTICATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-manifest-error-codes": [
          "INTERNAL",
          "RATE_LIMITED",
          "REQUEST_INVALID",
          "UNAUTHENTICATED"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "manifest_session",
        "description": "Set by the CWL sign-in at /auth/login (§9). Delegated tokens arrive in P5b."
      }
    },
    "schemas": {
      "AddMemberRequest": {
        "type": "object",
        "properties": {
          "puid": {
            "description": "The person’s ubcEduCwlPuid. They must have signed in once.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "collaborator"
            ]
          }
        },
        "required": [
          "puid",
          "role"
        ],
        "additionalProperties": false
      },
      "Audience": {
        "type": "object",
        "properties": {
          "scale": {
            "type": "string",
            "enum": [
              "solo",
              "class",
              "large_course",
              "public"
            ]
          },
          "burst": {
            "type": "string",
            "enum": [
              "steady",
              "synchronised"
            ]
          },
          "justification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "setBy": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "setAt": {
            "description": "An instant, ISO 8601 in UTC.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "scale",
          "burst",
          "justification",
          "setBy",
          "setAt"
        ],
        "additionalProperties": false
      },
      "EmptyRequest": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "Environment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sandbox",
              "staging",
              "production"
            ]
          },
          "hostname": {
            "description": "§23: `<slug>.<zone for this kind>`. Permanent.",
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "instance": {
            "description": "The instance the hostname reaches (§6 Route); for an app deployed before P4c, its newest instance. Null before any deploy.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Instance"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "kind",
          "hostname",
          "url",
          "instance"
        ],
        "additionalProperties": false
      },
      "EnvironmentList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Environment"
        }
      },
      "ErrorCode": {
        "description": "Every code the API answers with (api/error-codes.ts). Stable: a client switches on it (§20).",
        "type": "string",
        "enum": [
          "AI_BACKEND_UNAVAILABLE",
          "AI_CATALOGUE_DISABLED",
          "AI_CATALOGUE_EMPTY",
          "AI_KEY_EXPIRED",
          "AI_KEY_REVOKED",
          "AI_MODEL_NOT_PERMITTED",
          "AI_MODEL_UNKNOWN",
          "AI_PROJECT_BUDGET_EXCEEDED",
          "AI_ROUTE_NOT_PERMITTED",
          "AI_UNMAPPED",
          "AI_USER_BUDGET_EXCEEDED",
          "BLUEPRINT_NOT_FOUND",
          "BUILD_INVALID_INPUT",
          "BUILD_LOG_INVALID_QUERY",
          "CONFIG_BUILD_CREDENTIAL_SECRET_REQUIRED",
          "CONFIG_CONTROL_PLANE_ORIGIN_PORT_MISMATCH",
          "CONFIG_INVALID",
          "CONFIG_LITELLM_MASTER_KEY_REQUIRED",
          "CONFIG_MASTER_SECRET_REQUIRED",
          "CSRF_ORIGIN_REFUSED",
          "DEPLOY_INVALID_INPUT",
          "EVENTS_UPGRADE_REQUIRED",
          "FORBIDDEN",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_REUSED",
          "INTERNAL",
          "MEMBER_USER_NOT_FOUND",
          "NOT_FOUND",
          "PROJECT_INVALID_INPUT",
          "RATE_LIMITED",
          "RELEASE_AI_BUDGET_MISSING",
          "RELEASE_AI_DISABLED",
          "RELEASE_BLUEPRINT_NOT_FOUND",
          "RELEASE_BUILD_NOT_DEPLOYABLE",
          "RELEASE_BUILD_NOT_FOUND",
          "RELEASE_DIGEST_MISSING",
          "RELEASE_ENVIRONMENT_NOT_FOUND",
          "RELEASE_IMAGE_REPOSITORY_MISSING",
          "RELEASE_INVALID_INPUT",
          "RELEASE_LOCAL_IMAGE_ON_REMOTE_DRIVER",
          "RELEASE_MODEL_CLASSIFICATION_TOO_LOW",
          "RELEASE_MODEL_NOT_IN_CATALOGUE",
          "RELEASE_MODEL_UNCLASSIFIED",
          "RELEASE_NOT_FOUND",
          "RELEASE_PRODUCTION_GATE_UNAVAILABLE",
          "RELEASE_PROJECT_NOT_FOUND",
          "REQUEST_BODY_TOO_LARGE",
          "REQUEST_INVALID",
          "REQUEST_MEDIA_TYPE_UNSUPPORTED",
          "ROUTE_NOT_FOUND",
          "SAML_ASSERTION_REJECTED",
          "SAML_LOGIN_NOT_BOUND",
          "SAML_NO_PUID",
          "SAML_USER_UPSERT_FAILED",
          "SLUG_INVALID",
          "SLUG_RESERVED",
          "SLUG_TAKEN",
