{
  "name": "manifest",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run --project unit --project packages",
    "test:docker": "MANIFEST_TEST_DOCKER=1 vitest run --project docker",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "contract:generate": "pnpm --filter @manifest/contract generate",
    "contract:write": "MANIFEST_CONTRACT_WRITE=1 vitest run --project unit src/api/contract/document.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
