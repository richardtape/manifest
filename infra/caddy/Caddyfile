{
	# The admin API is how the driver adds a route for a name allocated at
	# runtime (§12, S1). Published to 127.0.0.1:7119 only.
	admin 0.0.0.0:2019
	local_certs
	# We install trust ourselves, in three places, during `make seed` (S7):
	# the macOS keychain, container trust stores, and the HOST Node processes.
	skip_install_trust
}

# The Manifest IdP, served at ONE name over trusted TLS.
#
# SAML is browser-mediated: the app redirects the BROWSER to the IdP, so the IdP
# needs a URL that is identical from the host, from a container and from `curl`
# — C1's bar. `http://127.0.0.1:7122` satisfies none of that. Caddy reaches the
# container by service name on the platform network (measured 2026-09-07: a
# 303 from `manifest-idp:80`), and `idp.manifest.internal` already resolves to
# 127.0.0.2 on the host and to Caddy inside a container.
#
# ABOVE the wildcard, and a separate block rather than a matcher inside it:
# Caddy prefers the more specific site, but the wildcard's `respond` is terminal
# and reviewing that ordering is cheaper than debugging it.
idp.manifest.internal {
	tls internal
	# No `header_up` block. Caddy already sets X-Forwarded-For, -Proto and -Host
	# by default, and setting X-Forwarded-Host explicitly makes it WARN on every
	# reload (measured 2026-09-08: "Unnecessary header_up X-Forwarded-Host").
	# SimpleSAMLphp does not depend on them here in any case: config.php sets an
	# absolute `baseurlpath`, so it builds https://idp.manifest.internal/... from
	# configuration rather than from the request — which is the same reason the
	# entityID is configured rather than derived.
	reverse_proxy manifest-idp:80
}

# §21 and §12 (Rich, 2026-09-16): the reference console and the API on ONE origin,
# through the edge — refused to every source but the host.
#
# A SITE HERE, NOT A RUNTIME ROUTE: routes added through the admin API are lost when the
# edge restarts (§12). An app's route comes back at the control plane's boot; the API a
# person uses to redeploy that app must not depend on it.
#
# AN ALLOW-LIST OF ONE ADDRESS: the edge is attached to every app network and answers any
# hostname asked of it by address, so name resolution is not a boundary (measured
# 2026-09-16 from inside a deployed app, P5 brief §3). The host's requests arrive from the
# platform network's gateway — 10.89.0.1, measured the same day, on the subnet P1 pins —
# while app networks are subnets Docker chooses. `make verify` asserts this address is the
# gateway, and infra/lib/common.sh's HOST_SOURCE_IP, so a moved subnet fails there first.
#
# INSIDE `route`, deliberately: outside one Caddy sorts `respond` ahead of
# `reverse_proxy`, and the placeholder would answer the API's paths too.
console.manifest.internal {
	tls internal
	request_body {
		max_size 10MB
	}
	# §20's baseline, which the control plane does not set itself.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'"
	}
	route {
		@outside not remote_ip 10.89.0.1/32
		respond @outside "manifest: the control plane is not reachable from this network" 403
		# The versioned API, the event stream (it upgrades through reverse_proxy — measured
		# in P5a Task 1 M3) and the sign-in endpoints (D23.8).
		@api path /v1/* /auth/*
		reverse_proxy @api host.docker.internal:7100 {
			# EVERY admin-API change reloads the edge's WHOLE config, and a reload closes
			# every WebSocket the old config proxied with 1001 Going Away — so without this
			# one app's deploy, anywhere on the platform, disconnects every event-stream
			# subscriber, and the build-log lines it misses are not replayed (measured
			# 2026-09-16, P5a sitting 2: one unrelated route PUT closed a stream in under
			# 3 s, and `make demo-ai` failed at step 5 with 1001). This lets a stream
			# outlive the config that opened it for an hour; a client reconnects after
			# that, and is replayed the events (D23.2).
			stream_close_delay 1h
		}
		# P5c Task 4: the reference console, a host process on 7104 (§21's inventory), on the
		# SAME ORIGIN as the API — so the session cookie, §20's CSRF origin and the control
		# plane's SAML return URL are one HTTPS origin with no CORS. `vite dev` while working
		# on it, `vite preview` for the acceptance.
		#
		# IT MUST STAY BELOW THE @api MATCHER AND INSIDE THIS `route` BLOCK: outside one Caddy
		# sorts handlers itself and a catch-all would answer /v1/* too.
		#
		# A 502 here means nothing is listening on 7104, NOT that the edge is broken — and a
		# `manifest OK host=… scheme=https` body means the request never reached this site at
		# all, it was answered by the wildcard. Read the body, never the status.
		#
		# The edge does NO SPA fallback and it PRESERVES `Host: console.manifest.internal`
		# (Task 1, M1) — so whatever serves 7104 owes both. `vite.config.ts` carries
		# `allowedHosts`, and Vite's own `appType: 'spa'` serves index.html for an unknown path.
		reverse_proxy host.docker.internal:7104
	}
}

# Manifest's own edge probe, on the INTERNAL listener. A §23 reserved label
# (infra/reserved-labels/labels.yaml, "Manifest's edge proxy") that lives in the BARE
# production zone — so before P6a it was served by the `*.manifest.internal` wildcard
# below, and moving that wildcard to :8443 would have left srv0 with no site matching
# this Host at all.
#
# WITHOUT THIS SITE THE NAME ANSWERS `200` WITH AN EMPTY BODY — measured in sitting 2.
# Sitting 1's F3 predicted a TLS handshake failure and that is not what happens: Caddy's
# certificate cache is APP-GLOBAL, so the `*.manifest.internal` certificate the :8443
# site below causes to be issued is presented by srv0 too. The handshake succeeds, srv0
# matches no site, and the answer is an empty 200 — which every `make verify` check that
# greps for `host=` would fail on, while any check reading the STATUS would pass. That is
# the more dangerous of the two symptoms, and it is why this site exists. Task 2 pins the
# name back to 127.0.0.2 in dnsmasq; this is the other half of the same repair.
#
# It belongs here rather than on the public listener for the same reason `console.` and
# `idp.` do: it is a platform surface, not a faculty app.
edge.manifest.internal {
	tls internal
	respond "manifest OK host={host} scheme={scheme} remote={remote_host} listener=internal" 200
}

# §12's PUBLIC listener. PRODUCTION ONLY, and the ONLY site bound to :8443 — which is what
# makes "a route bound to the wrong listener is simply unreachable" true on this machine
# rather than merely modelled (§21's divergence 2, rewritten by P6a; see Spec action 1).
#
# The address prefix is what puts this site on its own server: Caddy groups sites by their
# listening address, so every site here becomes `srv1` and every site without a prefix stays
# on `srv0`. The control plane addresses them by those names through the admin API, and
# `MANIFEST_CADDY_SERVER_PUBLIC` is the one setting that says which is which.
#
# THE PRODUCTION WILDCARD MOVED HERE FROM THE srv0 BLOCK BELOW. `*.manifest.internal` is the
# production zone (config.ts: MANIFEST_ZONE_PRODUCTION), and leaving it on srv0 would mean a
# production hostname answering on the INTERNAL address — the exact leak this split exists to
# refuse. `*.staging.` and `*.sandbox.` stay on srv0.
https://*.manifest.internal:8443 {
	tls internal
	respond "manifest OK host={host} scheme={scheme} remote={remote_host} listener=public" 200
}

# §23's INTERNAL platform zones, local equivalents. One wildcard certificate each,
# because every platform hostname is exactly one label deep. The production zone is NOT
# here — it is on :8443 above.
#
# THE TWO PLACEHOLDERS NOW DIFFER BY ONE WORD, AND THAT WORD IS THE MEASUREMENT: a
# response body saying `listener=internal` for a production hostname is the leak, visible
# without reading a config. Every existing assertion in the tree matches the PREFIX
# `manifest OK host=`, so appending it breaks none of them (checked, not assumed).
*.sandbox.manifest.internal, *.staging.manifest.internal {
	tls internal
	# The placeholder C1's demo asks for. P3 replaces the reverse_proxy target
	# per app via the admin API; this wildcard stays as the fallback.
	respond "manifest OK host={host} scheme={scheme} remote={remote_host} listener=internal" 200
}
