# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# macOS
.DS_Store

# Node
node_modules/
dist/
# Build OUTPUT only, anchored. It said `build/` until 2026-09-06, which also matched
# `packages/control-plane/src/build/` — §5's build module — so `git add` SILENTLY
# SKIPPED an entire module: green on the machine that wrote it, broken on every
# clone. Identical shape to the blanket `*.key` rule that skipped a test fixture
# (P3 defect 29), and to P1's still-open second-machine gap.
/build/
packages/*/build/
coverage/
*.tsbuildinfo
npm-debug.log*

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.key
*.pem

# Local platform state (see spec §21)
.manifest-local/
# MANIFEST_REPOS_ROOT's default in README's "Running the control plane": the bare
# repositories the control plane provisions per project. Git does not currently
# report them (a bare repo reads as a repository boundary), but that is an accident
# of their shape, not a rule — a repos root holding anything else would show up.
.manifest/

# P1 local substrate: minted at seed time, never committed
infra/ca/
infra/seed-cache/

# The registry token issuer. `make seed` generates it; the private half never
# leaves this machine.
infra/registry-auth/

# The Manifest IdP's SIGNING keypair, minted by `make up`. Held in separate
# custody from application secrets (§20) and never committed: regenerating it
# invalidates every SP that pinned the certificate.
infra/idp/cert/

# Generated test issuer keypair (runtime/docker/testing.ts). Never committed:
# the blanket *.key rule above is deliberate and stays absolute.
.test-fixtures/
